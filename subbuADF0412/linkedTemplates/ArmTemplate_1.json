							"name": "select1"
						},
						{
							"name": "derivedGender"
						},
						{
							"name": "derivedGenderFemale"
						},
						{
							"name": "filterAGE"
						},
						{
							"name": "derivedFIRSTNAME"
						},
						{
							"name": "castCost"
						},
						{
							"name": "derivedAirportName"
						},
						{
							"name": "alterRow1"
						},
