{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "subbuADF0412"
		},
		"AutoResolve_LS_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AutoResolve_LS'"
		},
		"AzureSqlDatabase_LS_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSqlDatabase_LS'"
		},
		"FileSystem_LS_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'FileSystem_LS'"
		},
		"AutoResolve_LS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://subbustorageac0412.dfs.core.windows.net/"
		},
		"AzureSqlDatabase_LS_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "nikhilrajserver123.database.windows.net"
		},
		"AzureSqlDatabase_LS_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "nikhilrajdb"
		},
		"AzureSqlDatabase_LS_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "nikhilraj"
		},
		"FileSystem_LS_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "C:\\ADF_Project"
		},
		"FileSystem_LS_properties_typeProperties_userId": {
			"type": "string",
			"defaultValue": "Hello SUBBU!"
		},
		"github_LS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "subbuADF0412_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AutoResolve_LS_accountKey": {
						"value": "[parameters('AutoResolve_LS_accountKey')]"
					},
					"AzureSqlDatabase_LS_password": {
						"value": "[parameters('AzureSqlDatabase_LS_password')]"
					},
					"FileSystem_LS_password": {
						"value": "[parameters('FileSystem_LS_password')]"
					},
					"AutoResolve_LS_properties_typeProperties_url": {
						"value": "[parameters('AutoResolve_LS_properties_typeProperties_url')]"
					},
					"AzureSqlDatabase_LS_properties_typeProperties_server": {
						"value": "[parameters('AzureSqlDatabase_LS_properties_typeProperties_server')]"
					},
					"AzureSqlDatabase_LS_properties_typeProperties_database": {
						"value": "[parameters('AzureSqlDatabase_LS_properties_typeProperties_database')]"
					},
					"AzureSqlDatabase_LS_properties_typeProperties_userName": {
						"value": "[parameters('AzureSqlDatabase_LS_properties_typeProperties_userName')]"
					},
					"github_LS_properties_typeProperties_url": {
						"value": "[parameters('github_LS_properties_typeProperties_url')]"
					},
					"FileSystem_LS_properties_typeProperties_host": {
						"value": "[parameters('FileSystem_LS_properties_typeProperties_host')]"
					},
					"FileSystem_LS_properties_typeProperties_userId": {
						"value": "[parameters('FileSystem_LS_properties_typeProperties_userId')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "subbuADF0412_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'subbuADF0412_ArmTemplate_0')]"
			]
		}
	]
}